library(readr)   # for parse_number

# Safely build a numeric matrix from selected columns
num_mat <- function(d, cols) {
  cols <- cols[!is.null(cols)]
  if (length(cols) == 0) return(matrix(NA_real_, nrow(d), 0))
  mm <- lapply(cols, function(cl) suppressWarnings(parse_number(as.character(d[[cl]]))))
  do.call(cbind, mm)
}

# Row-sum that always works on numerics
rsum <- function(d, cols) {
  m <- num_mat(d, cols)
  if (ncol(m) == 0) return(rep(NA_real_, nrow(d)))
  rowSums(m, na.rm = TRUE)
}

# One-off safe pull of a single numeric column (for tourism_aggregate, N:79, total)
num_col <- function(d, colname) {
  if (is.null(colname)) return(rep(NA_real_, nrow(d)))
  suppressWarnings(parse_number(as.character(d[[colname]])))
}

# Reuse your make_groups, but swap in num_col() where we pulled single columns
make_groups <- function(d, blk) {
  tibble::tibble(
    employment_primary_ind       = rsum(d, unlist(blk[c("A","B","D","E","F")])),
    employment_manufacturing     = rsum(d, unlist(blk[c("C")])),
    employment_trade_transport   = rsum(d, unlist(blk[c("G","H","I")])),
    employment_business_services = rsum(d, unlist(blk[c("J","K","L","M")])),
    employment_public_social     = rsum(d, unlist(blk[c("OQ","RX","SX")])),
    tourism_aggregate            = num_col(d, blk$TOUR_AGG),
    travel_agencies_n79          = num_col(d, blk$N79),
    total_in_employment          = num_col(d, blk$TOTAL_EMP)
  )
}

