# Helper: find exactly one column in a block by a pattern (first match)
pick1 <- function(block_names, pattern) {
  idx <- which(str_detect(block_names, regex(pattern, ignore_case = TRUE)))
  if (length(idx) == 0) return(NULL)
  block_names[idx[1]]
}

# ---- Column patterns (choose *non-overlapping* single-letter totals) ----
pat_A  <- "^A - Agriculture"
pat_B  <- "^B - Mining"
pat_C  <- "^C - Manufacturing"
pat_D  <- "^D - Electricity"
pat_E  <- "^E - Water supply"
