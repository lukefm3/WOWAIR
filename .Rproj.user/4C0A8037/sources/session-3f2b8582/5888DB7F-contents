# Build a list of picked names per block
pick_block <- function(block_names) {
  list(
    A  = pick1(block_names, pat_A),
    B  = pick1(block_names, pat_B),
    C  = pick1(block_names, pat_C),
    D  = pick1(block_names, pat_D),
    E  = pick1(block_names, pat_E),
    F  = pick1(block_names, pat_F),
