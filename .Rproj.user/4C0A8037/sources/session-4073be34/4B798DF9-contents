add_section <- function(title) {
  tibble(
    Indicator = paste0("\\multicolumn{7}{c}{\\textbf{", title, "}}"),
    `Relative Impact (%)` = "",
    `9-Month Cumulative Impact` = "",
    `95% CI Upper` = "",
    `95% CI Lower` = "",
    `p-value` = "",
    `RMSE (priors)` = ""
  )
}


vc_final <- bind_rows(
  add_section("Primary Result"),
  vc_out[1:3, ],   # passengers
  
  add_section("Impact of Bankruptcy on Fish Landing Weight"),
  vc_out[4, ],     # fish
  
  add_section("Impact of Bankruptcy on Other Countries"),
  vc_out[5:8, ],   # countries
  
  add_section("Impact of 2019 Bankruptcy on Iceland for Years Prior"),
  vc_out[9:10, ]   # years
)


latex_core <- vc_final %>%
  kable(
    format = "latex",
    booktabs = TRUE,
    escape = FALSE,  # REQUIRED for multicolumn
    col.names = col_names_latex,
    align = c("l", rep("r", 6))
  )


latex_core <- gsub(
  "\\\\multicolumn\\{7\\}\\{c\\}\\{\\\\textbf",
  "\\\\midrule\n\\\\multicolumn{7}{c}{\\\\textbf",
  latex_core
)


latex_core <- gsub(
  "\\\\begin\\{tabular\\}",
  "\\\\resizebox{\\\\textwidth}{!}{%\n\\\\begin{tabular}",
  latex_core
)

latex_core <- gsub(
  "\\\\end\\{tabular\\}",
  "\\\\end{tabular}%\n}",
  latex_core
)

latex_tbl <- paste0(
  "\\begin{table}[!htbp]
\\centering
\\caption{Impacts and Fit Statistics}
\\label{tab:complete_placebo_panel}
\\begin{threeparttable}
", latex_core, "
\\begin{tablenotes}
\\footnotesize
\\item \\textit{Note:} Reported measures by country showing variation in availability and level of detail across topic areas.
\\end{tablenotes}
\\end{threeparttable}
\\end{table}"
)

writeLines(latex_tbl, "placebo_impact_table.tex")

