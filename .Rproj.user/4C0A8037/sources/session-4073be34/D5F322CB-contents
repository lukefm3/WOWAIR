library(dplyr)
library(kableExtra)
library(stringr)

# Build table data
variable_choice <- rbind(
  total_t, national_t, foreign_t,
  fishing_impact_all,
  country_placebo_g, country_placebo_f, country_placebo_d, country_placebo_n,
  year_prior_1, year_prior_2
)

variable_choice$Indicator <- rownames(variable_choice)
variable_choice <- variable_choice %>% select(Indicator, everything())

# Keep markdown export if you still want it
writeLines(
  kable(variable_choice, caption = "Placebo Impact", format = "markdown", row.names = FALSE),
  "placebo_table.md"
)

# Add stars to Relative Impact (%)
vc_out <- variable_choice %>%
  mutate(
    `Relative Impact (%)` = sprintf("%.2f\\%%%s", `Relative Impact (%)`, pstars(`p-value`))
  )

col_names <- c(
  "Indicator",
  "Relative Impact (\\%)",
  "9-Month Cumulative Impact",
  "95\\% CI Upper",
  "95\\% CI Lower",
  "p-value",
  "RMSE (priors)"
)

# Create LaTeX table object
latex_tbl <- vc_out %>%
  kable(
    format = "latex",
    booktabs = TRUE,
    escape = FALSE,
    caption = "Placebo Counterfactual Analysis",
    col.names = col_names,
    align = c("l", rep("r", 6))
  )

# Convert to character so we can edit the raw LaTeX
latex_code <- as.character(latex_tbl)

# Replace table env with sidewaystable
latex_code <- latex_code |>
  str_replace("^\\\\begin\\{table\\}", "\\\\begin{sidewaystable}") |>
  str_replace("\\\\end\\{table\\}$", "\\\\end{sidewaystable}")

# Add resizebox around the tabular
latex_code <- latex_code |>
  str_replace(
    "\\\\begin\\{tabular\\}",
    "\\\\resizebox{\\\\textwidth}{!}{%\n\\\\begin{tabular}"
  ) |>
  str_replace(
    "\\\\end\\{tabular\\}",
    "\\\\end{tabular}\n}"
  )

# Add label right after caption
latex_code <- latex_code |>
  str_replace(
    "\\\\caption\\{Placebo Counterfactual Analysis\\}",
    "\\\\caption{Placebo Counterfactual Analysis}\n\\\\label{tab:complete_placebo_panel}"
  )

# Add tablenotes before end of sidewaystable
latex_code <- latex_code |>
  str_replace(
    "\\\\end\\{sidewaystable\\}$",
    paste0(
      "\\\\begin{tablenotes}\n",
      "\\\\footnotesize\n",
      "\\\\item \\\\textit{Note:} The number of stars denotes the significance level of the coefficient estimates based on p-values, where *** indicates $p<0.01$, ** indicates $p<0.05$, and * indicates $p<0.10$.\n",
      "\\\\end{tablenotes}\n",
      "\\\\end{sidewaystable}"
    )
  )

# Write final .tex file
writeLines(latex_code, "Main Figures and Tables/placebo_impact_table.tex")