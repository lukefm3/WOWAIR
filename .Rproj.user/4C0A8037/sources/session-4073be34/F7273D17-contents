library(readxl)
here()
# Read in the Excel sheet
raw <-read_excel("Summary Table.xlsx", sheet = "Table", col_names = TRUE)

header_row <- which(apply(raw, 1, function(x) any(!is.na(x) & x != "")))[1]
df <- raw[(header_row + 1):nrow(raw), ]
names(df) <- as.character(unlist(raw[header_row, ]))
names(df)[1] <- "row_label"

df$row_label <- trimws(as.character(df$row_label))

country_cols <- c(
  "Iceland", "Faroe Islands", "Greenland", "Norway",
  "Denmark", "Sweden", "Ireland", "UK"
)

get_row <- function(label) {
  out <- df %>% filter(row_label == label) %>% select(all_of(country_cols))
  if (nrow(out) == 0) stop(paste("Missing row:", label))
  out[1, ]
}

fmt_daylength <- function(x) {
  total_minutes <- round(as.numeric(x) * 24 * 60)
  paste0(total_minutes %/% 60, ":", str_pad(total_minutes %% 60, 2, pad = "0"))
}

final <- bind_rows(
  cbind(row_label = "Nordic Country",
        get_row("Nordic Countries")),
  cbind(row_label = "Distance to Iceland (mi.)",
        get_row("Distance to Iceland (mi.)")),
  cbind(row_label = "Seasonality (Difference Between Longest \\& Shortest Day)",
        get_row("Seasonality (Difference Between Longest & Shortest Day)")),
  cbind(row_label = "Population 2018 (million)",
        get_row("Population 2018 (million)")),
  cbind(row_label = "Annual Tourists per Capita (2013)",
        get_row("Annual Tourists per Person (2013)")),
  cbind(row_label = "Annual Tourists per Capita (2018)",
        get_row("Annual Tourists per Person (2018)")),
  cbind(row_label = "5 Year Change in Tourism Per Capita",
        get_row("5 Year Change in Tourism Per Person")),
  cbind(row_label = "Fish, Animals, and Animal Products as Export Product Share (2009)",
        get_row("Fish, Animals, and Animal Products as Export Product Share (2009)"))
)

final <- as.data.frame(final, stringsAsFactors = FALSE)

final[final$row_label == "Nordic Country", country_cols] <-
  lapply(final[final$row_label == "Nordic Country", country_cols], as.character)
final[final$row_label == "Nordic Country", "Ireland"] <- "-"
final[final$row_label == "Nordic Country", "UK"] <- "-"

final[final$row_label == "Distance to Iceland (mi.)", country_cols] <-
  lapply(final[final$row_label == "Distance to Iceland (mi.)", country_cols], function(x) {
    x <- round(as.numeric(x), 0)
    x <- as.character(x)
    x[is.na(x)] <- "-"
    x
  })
final[final$row_label == "Distance to Iceland (mi.)", "Iceland"] <- "-"

final[final$row_label == "Seasonality (Difference Between Longest \\& Shortest Day)", country_cols] <-
  lapply(final[final$row_label == "Seasonality (Difference Between Longest \\& Shortest Day)", country_cols], fmt_daylength)

for (r in c("Population 2018 (million)",
            "Annual Tourists per Capita (2013)",
            "Annual Tourists per Capita (2018)")) {
  final[final$row_label == r, country_cols] <-
    lapply(final[final$row_label == r, country_cols], function(x) formatC(as.numeric(x), digits = 2, format = "f"))
}

final[final$row_label == "5 Year Change in Tourism Per Capita", country_cols] <-
  lapply(final[final$row_label == "5 Year Change in Tourism Per Capita", country_cols], function(x) {
    paste0(round(as.numeric(x) * 100), "\\%")
  })

final[final$row_label == "Fish, Animals, and Animal Products as Export Product Share (2009)", country_cols] <-
  lapply(final[final$row_label == "Fish, Animals, and Animal Products as Export Product Share (2009)", country_cols], function(x) {
    paste0(round(as.numeric(x) * 100), "\\%")
  })

body_rows <- apply(final, 1, function(x) paste0("    ", paste(x, collapse = " & "), " \\\\"))
body_text <- paste(body_rows, collapse = "\n")

latex_table <- paste0(
  "\\begin{table}[htbp]\n",
  "\\centering\n",
  "\\caption{Forecasted Change in Tourism From Different Coefficient Groups}\n",
  "\\resizebox{\\textwidth}{!}{%\n",
  "\\begin{tabular}{lcccccccc}\n",
  "    \\toprule\n",
  "          & \\textbf{Iceland} & \\textbf{Faroe Islands} & \\textbf{Greenland} & \\textbf{Norway} & \\textbf{Denmark} & \\textbf{Sweden} & \\textbf{Ireland} & \\textbf{UK} \\\\\n",
  "    \\midrule\n",
  body_text, "\n",
  "    \\bottomrule\n",
  "    \\end{tabular}%\n",
  "}\n",
  "\\begin{tablenotes}\n",
  "Table notes environment without optional leadin.\n",
  "\\end{tablenotes}\n",
  "\\begin{tablenotes}[Source]\n",
  "Table notes environment with optional leadin (Source, in this case).\n",
  "\\end{tablenotes}\n",
  "\\end{table}\n"
)

cat(latex_table)