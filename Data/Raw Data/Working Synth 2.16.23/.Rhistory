headers <- read.csv("C:/Users/lukef/Desktop/Publish WOWAIR/monthly_wowair.csv", header = F, nrows = 1, as.is = T)
month <- read.csv("C:/Users/lukef/Desktop/Publish WOWAIR/monthly_wowair.csv", skip = 2, header = F)
colnames(month) <- headers
month$date <- mdy(month$date)
# make each column numeric
month[,c(2:length(colnames(month)))] <- as.data.frame(lapply(month[,c(2:length(colnames(month)))], as.numeric))
# Which columns do I want to drop?
# faroe wages: 77:82, 84:90, 92
# remove duplicated visitor data greenland: 7
month <- month[,-c(7,77:82,84:90,92)]
month <- month %>% relocate(date)
quarter <- month
quarter <- quarter[colSums(is.na(quarter)) < nrow(quarter)]
quarter[,c(2:85)] <- as.data.frame(as.numeric(quarter[,c(2:85)]))
quarter$quarter <- paste0(year(quarter$date),"/",quarter(quarter$date)) # make an quarter column
colnames(quarter)
quarter <- quarter %>% dplyr::group_by(quarter) %>% summarise(
date = min(date),
unemprate_est_faroe = mean(unemprate_faroe, na.rm=T),
unemployed_persons_est_faroe = mean(unemployed_persons_faroe, na.rm=T),
